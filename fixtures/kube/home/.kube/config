# Synthetic kubeconfig for Den tests. Values marked PRIVATE must never be shown.
apiVersion: v1
kind: Config
current-context: prod-eks
preferences: {}
clusters:
- name: docker-desktop
  cluster:
    server: https://127.0.0.1:6443
    certificate-authority-data: PRIVATE-CA-DATA
- name: prod
  cluster:
    server: https://PRIVATE-HOST.gr7.eu-west-1.eks.amazonaws.com
    certificate-authority-data: PRIVATE-CA-DATA
    proxy-url: http://PRIVATE-PROXY:3128
- name: staging
  cluster:
    server: https://34.0.0.9
- name: legacy
  cluster:
    server: http://10.0.0.5:8080
    insecure-skip-tls-verify: true
- name: minikube
  cluster:
    server: https://192.168.49.2:8443
    certificate-authority: /Users/PRIVATE-PATH/.minikube/ca.crt
- name: old-cluster
  cluster:
    server: https://old.example
contexts:
- name: docker-desktop
  context: {cluster: docker-desktop, user: docker-desktop}
- name: prod-eks
  context: {cluster: prod, user: eks-admin, namespace: payments}
- name: staging-gke
  context: {cluster: staging, user: gke-user}
- name: legacy
  context: {cluster: legacy, user: legacy-token}
- name: lab
  context: {cluster: minikube, user: lab-basic}
- name: orphan
  context: {cluster: gone, user: docker-desktop}
- name: minikube
  context: {cluster: minikube, user: minikube, namespace: default}
users:
- name: docker-desktop
  user:
    client-certificate-data: PRIVATE-CERT-DATA
    client-key-data: PRIVATE-KEY-DATA
- name: eks-admin
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: /opt/homebrew/bin/aws
      args: [eks, get-token, --cluster-name, PRIVATE-ARG]
      env:
      - name: AWS_PROFILE
        value: PRIVATE-ENV-VALUE
      interactiveMode: IfAvailable
- name: gke-user
  user:
    auth-provider:
      name: gcp
      config: {access-token: PRIVATE-ACCESS-TOKEN, cmd-path: /PRIVATE/gcloud}
- name: legacy-token
  user:
    token: PRIVATE-BEARER-TOKEN
- name: lab-basic
  user:
    username: PRIVATE-USERNAME
    password: PRIVATE-PASSWORD
- name: minikube
  user:
    client-certificate: /Users/PRIVATE-PATH/.minikube/client.crt
    client-key: /Users/PRIVATE-PATH/.minikube/client.key
- name: old-user
  user:
    tokenFile: /PRIVATE/token
